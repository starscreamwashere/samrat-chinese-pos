# ---------------------------------------------------------------------------
# Samrat Chinese POS — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string (used as a plain Postgres DB).
# Supabase → Project Settings → Database → Connection string → URI (use the
# "Session"/pooler string for serverless). Add ?sslmode=require if needed.
# Example: postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/samrat?schema=public"

# NextAuth — generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the app. Local: http://localhost:3000 . Prod: your Vercel URL.
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Cloud API (Meta) — for the nightly summary.
WHATSAPP_API_TOKEN="your-meta-whatsapp-permanent-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
# Owner's WhatsApp number in international format, digits only. e.g. 918591929077
OWNER_WHATSAPP_NUMBER="918591929077"
# Approved template for the unprompted 7pm push (required for reliable delivery
# — Meta blocks free-form text outside the 24h window). Register a template with
# 4 body parameters in Meta, then put its name + language here. If left blank,
# the cron falls back to a plain-text message (only delivers inside the 24h
# window). See README "WhatsApp setup" for the exact template body to register.
WHATSAPP_TEMPLATE_NAME="daily_summary"
WHATSAPP_TEMPLATE_LANG="en"

# Shared secret that protects the cron endpoint. Vercel Cron sends it as a
# Bearer token. Generate with:  openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-secret"

# Credentials for the owner account created by the seed script.
SEED_OWNER_EMAIL="owner@samratchinese.local"
SEED_OWNER_PASSWORD="change-me-before-launch"
SEED_OWNER_NAME="Samrat Owner"
